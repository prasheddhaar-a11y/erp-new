DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pinesphere_erp
SECRET_KEY=change-this-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
KEEP_ME_REFRESH_TOKEN_EXPIRE_DAYS=30
FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=mailbox@pinesphere.com
SMTP_PASSWORD=use-app-password-or-smtp-password
SMTP_FROM_EMAIL=mailbox@pinesphere.com
SMTP_FROM_NAME=Pinesphere ERP
SMTP_USE_TLS=true
SMTP_USE_SSL=false
INVITE_TOKEN_EXPIRE_HOURS=48
AUTH_OTP_EXPIRE_MINUTES=10
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_DEBUG_OTP=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_STATE_EXPIRE_MINUTES=10
DEFAULT_REGISTRATION_ROLE=student
